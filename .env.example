# AS Yachting — ortam değişkenleri
#
# Bu dosya ÖRNEKTİR ve depoya girer. Gerçek değerler için kopyalayın:
#   cp .env.example .env.local
# .env* dosyaları .gitignore'da (bu örnek dosya hariç).
#
# Vercel'de bu değişkenler Project Settings → Environment Variables
# altına girilir. NEXT_PUBLIC_ önekli değişkenler DERLEME ANINDA gömülür;
# değiştirdikten sonra yeniden deploy almak gerekir.

# Sitenin genel adresi. Canonical adresler, sitemap, robots ve JSON-LD
# bağlantılarının tamamı buradan üretilir. Sonunda eğik çizgi OLMAMALI.
NEXT_PUBLIC_SITE_URL=https://as-yachting.vercel.app

# ⛔ KRİTİK KURAL 3 — İNDEKSLEME KİLİDİ
# Site şu an demo fiyatlarla ve yer tutucu içerikle çalışıyor.
# Yayın kontrol listesi (AS_YACHTING_PROJE.md → Bölüm 6, "Faz Tanımı —
# Faz 7 — SEO & Yayın") tamamlanmadan bu değer true YAPILMAZ.
# Aksi halde Google'a gerçek olmayan fiyat ve eksik tekne bilgisi
# indekslenir, sonradan temizlemesi haftalar sürer.
#
# false → robots.txt "Disallow: /" verir, her sayfa "noindex, nofollow" olur
# true  → site aramaya açılır, sitemap bildirilir
NEXT_PUBLIC_ALLOW_INDEXING=false
