# AS Yachting — ortam değişkenleri
#
# Bu dosya ÖRNEKTİR ve depoya girer. Gerçek değerler için kopyalayın:
#   cp .env.example .env.local
# .env* dosyaları .gitignore'da (bu örnek dosya hariç).
#
# Vercel'de bu değişkenler Project Settings → Environment Variables
# altına girilir. NEXT_PUBLIC_ önekli değişkenler DERLEME ANINDA gömülür;
# değiştirdikten sonra yeniden deploy almak gerekir.

# Sitenin genel adresi. Canonical adresler, sitemap, robots ve JSON-LD
# bağlantılarının tamamı buradan üretilir. Sonunda eğik çizgi OLMAMALI.
NEXT_PUBLIC_SITE_URL=https://as-yachting.vercel.app

# ⛔ KRİTİK KURAL 3 — İNDEKSLEME KİLİDİ
# Site şu an demo fiyatlarla ve yer tutucu içerikle çalışıyor.
# Yayın kontrol listesi (AS_YACHTING_PROJE.md → Bölüm 6, "Faz Tanımı —
# Faz 7 — SEO & Yayın") tamamlanmadan bu değer true YAPILMAZ.
# Aksi halde Google'a gerçek olmayan fiyat ve eksik tekne bilgisi
# indekslenir, sonradan temizlemesi haftalar sürer.
#
# false → robots.txt "Disallow: /" verir, her sayfa "noindex, nofollow" olur
# true  → site aramaya açılır, sitemap bildirilir
NEXT_PUBLIC_ALLOW_INDEXING=false

# ============================================================================
# SEYİR DEFTERİ — misafir fotoğraf panosu
# ----------------------------------------------------------------------------
# Bu blok BOŞ bırakılabilir: değişkenler yoksa özellik kendiliğinden kapanır.
# Pano ana sayfada "ilk anıyı sen bırak" gösterir, yükleme sayfası "yakında"
# der; site hiçbir şekilde kırılmaz.
# ============================================================================

# --- Supabase (Faz 6 ile aynı proje) ---
# Project Settings → API. URL tarayıcıya gider (NEXT_PUBLIC_), service role
# anahtarı GİTMEZ — yalnızca sunucuda okunur (lib/logbook-server.ts).
# ⛔ SUPABASE_SERVICE_ROLE_KEY tüm RLS kurallarını atlar; asla NEXT_PUBLIC_
#    yapılmaz, asla istemci koduna yazılmaz, asla depoya commit edilmez.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (onay e-postası) ---
# resend.com → API Keys. Gönderen alan adı Resend'de doğrulanmış olmalı.
RESEND_API_KEY=
# Onay e-postasının gideceği adres (kaptan Serkan)
LOGBOOK_NOTIFY_EMAIL=
# Kopyası (isteğe bağlı; boş bırakılabilir)
LOGBOOK_CC_EMAIL=
# Gönderen. Alan adı doğrulanana kadar Resend'in test adresi kullanılabilir.
LOGBOOK_FROM_EMAIL="Seyir Defteri <onboarding@resend.dev>"

# --- Gizli anahtarlar ---
# Rastgele uzun bir dizge. IP özetlerinin tuzu olarak da kullanılır;
# değiştirilirse günlük yükleme sınırı sayacı sıfırlanır.
# Üretmek için: openssl rand -base64 32
LOGBOOK_ADMIN_SECRET=

# Misafirlere verilen yükleme kodu. Kaptan turdan sonra QR / WhatsApp ile
# şu biçimde paylaşır:  https://<site>/seyir-defteri/yukle?k=<kod>
# Tahmin edilmesi zor ama söylenebilir bir şey olsun (ör. mavi-tur-2026).
LOGBOOK_UPLOAD_CODE=
